{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CLI-owned collaboration orchestration plan",
  "type": "object",
  "required": ["version", "plan_id", "objective", "source", "api_policy", "nodes"],
  "properties": {
    "version": {"const": 1},
    "plan_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,63}$"},
    "objective": {"type": "string", "minLength": 1},
    "evidence_class": {"enum": ["offline_schedule_estimate", "measured_cli_replay"]},
    "decision_provider": {"enum": ["rules", "offline_mock"]},
    "source": {
      "type": "object",
      "required": ["generated_by", "revision"],
      "properties": {
        "generated_by": {"enum": ["claude_code_cli", "codex_cli", "supervisor"]},
        "revision": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "api_policy": {
      "type": "object",
      "required": ["third_party_api", "model_call_owners"],
      "properties": {
        "third_party_api": {"const": false},
        "model_call_owners": {
          "type": "array",
          "items": {"enum": ["claude_code_cli", "codex_cli"]},
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "executor", "transport", "session_policy", "depends_on", "context", "source", "scope", "forbidden", "verify", "write_scope", "expected_seconds"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,63}$"},
          "title": {"type": "string", "minLength": 1},
          "executor": {"enum": ["claude", "codex"]},
          "transport": {"enum": ["claude_code_cli", "codex_cli"]},
          "session_policy": {"const": "reuse_existing"},
          "surface_ref": {"type": "string", "pattern": "^surface:[0-9]+$"},
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "context": {"type": "string", "minLength": 1},
          "source": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "scope": {"type": "string", "minLength": 1},
          "forbidden": {"type": "string", "minLength": 1},
          "verify": {"type": "string", "minLength": 1},
          "write_scope": {"type": "string", "minLength": 1},
          "expected_seconds": {"type": "number", "exclusiveMinimum": 0},
          "retry_seconds": {"type": "number", "minimum": 0},
          "observed_retries": {"type": "integer", "minimum": 0, "maximum": 3}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
